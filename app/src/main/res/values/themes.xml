<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PulsarNav" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Claude Obsidian & Wine Red Theme Mapping -->
        <item name="colorPrimary">@color/wine_red</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/wine_red_subtle</item>
        <item name="colorOnPrimaryContainer">@color/wine_red_light</item>

        <item name="colorSecondary">@color/wine_red_light</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">@color/surface_card</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>

        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_card</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/surface_border</item>

        <item name="materialAlertDialogTheme">@style/ObsidianAlertDialog</item>
        <item name="alertDialogTheme">@style/ObsidianAlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/ObsidianBottomSheetDialog</item>
    </style>

    <style name="ObsidianAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/ObsidianDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/ObsidianDialogButtonSecondary</item>
        <item name="buttonBarNeutralButtonStyle">@style/ObsidianDialogButtonSecondary</item>
    </style>

    <style name="ObsidianDialogButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/wine_red_light</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ObsidianDialogButtonSecondary" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="ObsidianBottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/ObsidianBottomSheetModal</item>
    </style>

    <style name="ObsidianBottomSheetModal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">#141318</item>
    </style>
</resources>
