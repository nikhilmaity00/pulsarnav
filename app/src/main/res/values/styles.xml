<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.PulsarNav.SectionHeader" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.PulsarNav.Card" parent="">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/surface_border</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
    </style>

    <style name="Widget.PulsarNav.CardHeaderButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_height">@dimen/btn_height_card_header</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">0dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/surface_elevated</item>
        <item name="cornerRadius">@dimen/btn_corner_radius_pill</item>
        <item name="strokeColor">@color/surface_border</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
    </style>

    <style name="Widget.PulsarNav.PillBadge" parent="">
        <item name="android:background">@drawable/pill_badge</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.PulsarNav.BottomSheetHandle" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">4dp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginBottom">@dimen/space_lg</item>
        <item name="android:background">@drawable/pill_badge</item>
        <item name="android:backgroundTint">@color/surface_border</item>
    </style>
</resources>
