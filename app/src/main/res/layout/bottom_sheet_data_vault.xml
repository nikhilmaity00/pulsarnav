<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutDataVaultSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_obsidian"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/pill_badge"
        android:backgroundTint="#33333F" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle_dot"
            android:backgroundTint="@color/surface_elevated"
            android:gravity="center"
            android:text="🔐"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data Vault &amp; Migration"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Transfer metrics &amp; trips to another phone"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/surface_border_subtle" />

    <!-- SECTION 1: INSTANT QR CODE TRANSFER -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:text="1. INSTANT QR CODE PHONE MIGRATION"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- QR Code Display Box (Initially Hidden until user taps "Generate QR") -->
    <LinearLayout
        android:id="@+id/layoutQrContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivVaultQrCode"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:background="@color/surface_card"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Scan this with PulsarNav on your new phone"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetShowQr"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_height_secondary"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_elevated"
            android:text="📱 Show QR"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="@dimen/btn_corner_radius"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="@dimen/card_stroke_width" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetScanQr"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_height_secondary"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/wine_red_subtle"
            android:text="📷 Scan QR"
            android:textColor="@color/wine_red_light"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="@dimen/btn_corner_radius"
            app:strokeColor="@color/wine_red_border"
            app:strokeWidth="@dimen/card_stroke_width" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/surface_border_subtle" />

    <!-- SECTION 2: FULL METRICS VAULT BACKUP (.PNAV / JSON) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:text="2. COMPLETE METRICS BACKUP (ALL TRIPS &amp; FUEL LOGS)"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp"
        android:text="Export an encrypted vault bundle to send via Quick Share, Drive or Files."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetExportVault"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_height_primary"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/wine_red"
            android:text="📤 Export Vault"
            android:textColor="@color/on_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="@dimen/btn_corner_radius" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetImportVault"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_height_primary"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_elevated"
            android:text="📥 Import File"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="@dimen/btn_corner_radius"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="@dimen/card_stroke_width" />
    </LinearLayout>

</LinearLayout>
