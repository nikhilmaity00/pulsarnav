<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutRecalibrateSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_obsidian"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/pill_badge"
        android:backgroundTint="#33333F" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle_dot"
            android:backgroundTint="@color/surface_elevated"
            android:gravity="center"
            android:text="🔄"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instrument Cluster Sync"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Check your Pulsar NS200 cluster and sync readings"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/surface_border_subtle" />

    <!-- 1. DTE Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1. Distance to Empty (DTE)"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:text="Kilometers displayed on the cluster DTE reading"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/etRecalibrateDte"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_obsidian_input"
        android:hint="e.g. 380"
        android:inputType="number"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- 2. Odometer Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="2. Total Odometer (ODO)"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:text="Cumulative motorcycle odometer reading in km"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/etRecalibrateOdo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_obsidian_input"
        android:hint="e.g. 12450.5"
        android:inputType="numberDecimal"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- 3. Fuel Tank Level Quick Presets -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="3. Fuel Level &amp; Tank Status"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:text="Quick select from cluster fuel bars or enter liters (Total 12.0L)"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipPresetReserve"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_card"
            android:paddingHorizontal="0dp"
            android:paddingVertical="0dp"
            android:text="Reserve\n(2.4L)"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipPresetQuarter"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_card"
            android:paddingHorizontal="0dp"
            android:paddingVertical="0dp"
            android:text="1/4 Tank\n(3.0L)"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipPresetHalf"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_card"
            android:paddingHorizontal="0dp"
            android:paddingVertical="0dp"
            android:text="1/2 Tank\n(6.0L)"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipPresetFull"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_card"
            android:paddingHorizontal="0dp"
            android:paddingVertical="0dp"
            android:text="Full Tank\n(12.0L)"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Liters:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etRecalibrateFuelLiters"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_obsidian_input"
            android:hint="0.0 - 12.0 L"
            android:inputType="numberDecimal"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Save Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveRecalibration"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_height_primary"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/wine_red"
        android:letterSpacing="0.02"
        android:text="🔄  Save &amp; Sync with Cluster"
        android:textColor="@color/on_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="@dimen/btn_corner_radius" />

</LinearLayout>
