<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top Fixed App Bar -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTopBarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.02"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/viewTopConnectionDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/circle_dot"
                android:backgroundTint="@color/status_disconnected" />

            <TextView
                android:id="@+id/tvTopConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:letterSpacing="0.08"
                android:text="@string/status_offline"
                android:textColor="@color/text_tertiary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Non-blocking Hardware Readiness Clues (Bluetooth & GPS status) -->
            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutHardwareWarnings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipBtWarning"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/pill_badge"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:singleLine="true"
                        android:text="@string/warning_bt_off"
                        android:textColor="@color/amber_accent"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chipGpsWarning"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/pill_badge"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:singleLine="true"
                        android:text="@string/warning_gps_off"
                        android:textColor="@color/amber_accent"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chipPermWarning"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/pill_badge"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:singleLine="true"
                        android:text="@string/warning_perms"
                        android:textColor="@color/amber_accent"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTopSos"
            style="@style/Widget.PulsarNav.CardHeaderButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height_compact"
            android:backgroundTint="@color/wine_red_subtle"
            android:letterSpacing="0.04"
            android:paddingHorizontal="16dp"
            android:text="@string/action_sos"
            android:textColor="@color/wine_red_light"
            android:textSize="13sp"
            app:cornerRadius="20dp"
            app:strokeColor="@color/wine_red_border" />
    </LinearLayout>

    <View
        android:id="@+id/viewTopDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/layoutTopBar"
        android:background="@color/surface_border_subtle" />

    <!-- Main Content Containers -->
    <FrameLayout
        android:id="@+id/layoutContentFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:layout_below="@id/viewTopDivider">

        <include
            android:id="@+id/tabCockpit"
            layout="@layout/tab_cockpit"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/tabFuel"
            layout="@layout/tab_fuel"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/tabSupport"
            layout="@layout/tab_support"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/tabAccount"
            layout="@layout/tab_account"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Ather-Style Glove-Friendly 72dp Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:layout_alignParentBottom="true"
        android:background="@color/surface"
        app:elevation="0dp"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/bottom_nav_colors"
        app:itemTextColor="@color/bottom_nav_colors"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>
